# Optional LLM narrator for POST /agent/narrate (and the UI "Narrate" button).
# Copy this file to `.env` (which is gitignored) and fill in your own key.
# Get a key at https://openrouter.ai/keys — NEVER commit a real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
HUMANITY_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
